# Claves de tráfico en tiempo real para MobiPredict.
# Copie este archivo como .env (en esta misma carpeta) y pegue sus claves. El archivo .env NO se sube a Git.
# Basta con una sola clave; con varias, MobiPredict combina las fuentes.

# TomTom: https://developer.tomtom.com  ->  "Get your free API key" (producto Traffic API)
TOMTOM_API_KEY=

# HERE: https://platform.here.com  ->  Access Manager -> Apps -> crear app -> API key
HERE_API_KEY=

# Google Maps: https://console.cloud.google.com  ->  habilitar "Routes API" -> Credenciales -> clave de API
# (Google exige una cuenta de facturación aunque se quede dentro del uso gratuito)
GOOGLE_MAPS_API_KEY=

# Opcional: cupo diario de consultas por proveedor (MobiPredict deja de consultar al llegar a él)
# MOBIPREDICT_CUPO_TOMTOM=2400
# MOBIPREDICT_CUPO_HERE=1000
# MOBIPREDICT_CUPO_GOOGLE=160
# Opcional: minutos entre rondas de cada proveedor (22 consultas por ronda)
# MOBIPREDICT_INTERVALO_TOMTOM=15
# MOBIPREDICT_INTERVALO_HERE=30
# MOBIPREDICT_INTERVALO_GOOGLE=120
# Opcional: recolector automático al arrancar la API (auto = solo si hay alguna clave; 1 = siempre; 0 = nunca)
# MOBIPREDICT_ENVIVO_AUTO=auto
# Opcional: horario de recolección en hora local (de HORA_INICIO a antes de HORA_FIN)
# MOBIPREDICT_ENVIVO_HORA_INICIO=5
# MOBIPREDICT_ENVIVO_HORA_FIN=21
